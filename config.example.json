{
  "_comment": "fry config. Copy to ~/.fry/config.json (or $FRY_HOME/config.json) and edit the 'secret' fields. Secrets are op:// (1Password) or env:NAME references -- never plaintext. ROUTER mode gives a cross-provider /model list inside Claude Code (and feeds agent teams); NATIVE mode is one backend per session (the only way to use a Claude subscription).",
  "defaults": {
    "claude": {
      "mode": "native",
      "provider": "anthropic"
    },
    "codex": {
      "mode": "native",
      "provider": "openai"
    },
    "grok": {
      "mode": "native",
      "provider": "xai"
    }
  },
  "router": {
    "_note": "Compiled into ~/.claude-code-router/config.json. 'roles' map to claude-code-router's Router{} (which model serves which task class). 'default' is what a fresh session opens on; override per-launch with `fry launch claude --model <provider>,<model>`.",
    "config_path": "~/.claude-code-router/config.json",
    "port": 3456,
    "roles": {
      "default": "ollama,qwen3-coder:latest"
    }
  },
  "agents": {
    "claude": {
      "bin": [
        "claude",
        "claude.cmd",
        "claude.exe"
      ]
    },
    "codex": {
      "bin": [
        "codex",
        "codex.cmd",
        "codex.exe"
      ]
    },
    "grok": {
      "bin": [
        "grok",
        "grok.cmd",
        "grok.exe"
      ]
    }
  },
  "providers": {
    "_credentials_note": "Router provider API keys can also live in ~/.fry/credentials.json as {'OPENAI_API_KEY': 'sk-...'} instead of op:// references. Set via: fry credentials set <provider> or fry credentials import-env <provider>",
    "anthropic": {
      "_note": "NATIVE: subscription login (leave secret null) or an injected ANTHROPIC_API_KEY. ROUTER: disabled by default because routing Claude through a proxy needs an API key (no subscription) and a known transformer. To enable Anthropic-direct in the router, set router.capable=true, set router.secret to your op:// Anthropic API key, and confirm the transformer your ccr build expects. By default, Claude models reach the router via OpenRouter instead (one key, well-supported).",
      "secret": null,
      "default_model": null,
      "native": {
        "default_model": null,
        "claude": {
          "requires_model": false,
          "requires_key": false,
          "clear_env": [
            "ANTHROPIC_BASE_URL",
            "ANTHROPIC_AUTH_TOKEN",
            "ANTHROPIC_CUSTOM_HEADERS"
          ],
          "env": {
            "ANTHROPIC_MODEL": "{model}"
          },
          "secret_env": "ANTHROPIC_API_KEY"
        }
      },
      "router": {
        "capable": false,
        "api_base_url": "https://api.anthropic.com/v1/messages",
        "env_var": "ANTHROPIC_API_KEY",
        "secret": null,
        "transformer": null,
        "models": [
          "claude-opus-4-6",
          "claude-sonnet-4-6"
        ]
      }
    },
    "openrouter": {
      "_note": "FUTURE/INACTIVE by default (capable:false, no key, no 1Password). To activate: set providers.openrouter.router.capable=true and providers.openrouter.router.secret to a hardcoded key via \"literal:sk-or-...\" (no 1P) or \"op://Vault/Item/field\". Then add its models to router.roles if you want them as defaults. Until activated, fry routes Ollama only and needs no key.",
      "secret": "op://FryFarm/OpenRouter/credential",
      "default_model": "anthropic/claude-sonnet-4.6",
      "router": {
        "capable": false,
        "api_base_url": "https://openrouter.ai/api/v1/chat/completions",
        "env_var": "OPENROUTER_API_KEY",
        "secret": null,
        "transformer": "openrouter",
        "models": [
          "anthropic/claude-opus-4.6",
          "anthropic/claude-sonnet-4.6",
          "google/gemini-2.5-pro",
          "deepseek/deepseek-chat",
          "moonshotai/kimi-k2"
        ]
      },
      "native": {
        "claude": {
          "requires_model": true,
          "requires_key": true,
          "clear_env": [],
          "env": {
            "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
            "ANTHROPIC_AUTH_TOKEN": "{api_key}",
            "ANTHROPIC_API_KEY": "",
            "ANTHROPIC_CUSTOM_HEADERS": "x-api-key: {api_key}",
            "ANTHROPIC_MODEL": "{model}"
          }
        },
        "codex": {
          "requires_model": true,
          "requires_key": true,
          "env": {
            "OPENROUTER_API_KEY": "{api_key}"
          },
          "args": [
            "-c",
            "model_provider=\"openrouter\"",
            "-c",
            "model=\"{model}\"",
            "-c",
            "model_providers.openrouter.name=\"OpenRouter\"",
            "-c",
            "model_providers.openrouter.base_url=\"https://openrouter.ai/api/v1\"",
            "-c",
            "model_providers.openrouter.env_key=\"OPENROUTER_API_KEY\"",
            "-c",
            "model_providers.openrouter.wire_api=\"chat\""
          ]
        }
      }
    },
    "ollama": {
      "_note": "Local Ollama. router.expand=true auto-includes EVERY model from `ollama list` in the /model list -- no need to enumerate them by hand. Codex only honors localhost for Ollama, which is fine here.",
      "secret": null,
      "base_url": "http://localhost:11434",
      "default_model": "qwen3-coder:latest",
      "router": {
        "capable": true,
        "kind": "ollama",
        "expand": true,
        "api_base_url": "http://localhost:11434/v1/chat/completions",
        "env_var": null,
        "secret": null,
        "literal_key": "ollama",
        "transformer": null,
        "models": []
      },
      "native": {
        "default_model": "qwen3-coder:latest",
        "claude": {
          "requires_model": true,
          "requires_key": false,
          "clear_env": [
            "ANTHROPIC_CUSTOM_HEADERS"
          ],
          "env": {
            "ANTHROPIC_BASE_URL": "http://localhost:11434",
            "ANTHROPIC_AUTH_TOKEN": "ollama",
            "ANTHROPIC_API_KEY": "",
            "ANTHROPIC_MODEL": "{model}"
          }
        },
        "codex": {
          "requires_model": true,
          "requires_key": false,
          "env": {
            "OLLAMA_API_KEY": "ollama"
          },
          "args": [
            "-c",
            "model_provider=\"oss\"",
            "-c",
            "model=\"{model}\""
          ]
        }
      }
    },
    "openai": {
      "_note": "OpenAI / Codex models. ROUTER: set router.capable=true and router.secret to your op:// OpenAI API key to expose gpt-* in the router. GPT-5.x models require the maxcompletiontokens transformer to rewrite max_tokens -> max_completion_tokens. NATIVE codex: native ChatGPT login (secret null) or injected OPENAI_API_KEY.",
      "secret": null,
      "default_model": null,
      "router": {
        "capable": false,
        "api_base_url": "https://api.openai.com/v1/chat/completions",
        "env_var": "OPENAI_API_KEY",
        "secret": null,
        "transformer": "maxcompletiontokens",
        "models": [
          "gpt-5.5",
          "gpt-5.4",
          "gpt-5.4-mini",
          "gpt-5.4-nano",
          "gpt-4.1",
          "gpt-4.1-mini",
          "gpt-4.1-nano",
          "gpt-4o",
          "gpt-4o-mini"
        ]
      },
      "native": {
        "codex": {
          "requires_model": false,
          "requires_key": false,
          "clear_env": [],
          "env": {},
          "secret_env": "OPENAI_API_KEY"
        }
      }
    },
    "xai": {
      "_note": "xAI/Grok. Router: JWT from ~/.grok/auth.json (~6h expiry), fallback XAI_API_KEY env. Native: requires XAI_API_KEY env var. Set router.capable=true to enable.",
      "secret": "env:XAI_API_KEY",
      "base_url": "https://api.x.ai",
      "default_model": "grok-3",
      "router": {
        "capable": false,
        "kind": "openai_compat",
        "expand": true,
        "expand_base_url": "https://api.x.ai",
        "discover": "xai",
        "api_base_url": "https://api.x.ai/v1/chat/completions",
        "env_var": "XAI_API_KEY",
        "secret": null,
        "transformer": null,
        "models": [
          "grok-4.20-0309-non-reasoning",
          "grok-4.20-0309-reasoning",
          "grok-4.3",
          "grok-build-0.1"
        ],
        "models_fallback": []
      },
      "native": {
        "default_model": "grok-3",
        "claude": {
          "requires_model": true,
          "requires_key": true,
          "clear_env": [
            "ANTHROPIC_CUSTOM_HEADERS"
          ],
          "env": {
            "ANTHROPIC_BASE_URL": "https://api.x.ai",
            "ANTHROPIC_AUTH_TOKEN": "{api_key}",
            "ANTHROPIC_API_KEY": "",
            "ANTHROPIC_MODEL": "{model}"
          }
        },
        "grok": {
          "requires_model": false,
          "requires_key": false,
          "env": {}
        }
      }
    },
    "deepseek-direct": {
      "_note": "Direct DeepSeek API (separate billing from Ollama). Uses DeepSeek's Anthropic-compatible endpoint at api.deepseek.com/anthropic. Set secret to your op:// URI for your DeepSeek API key from platform.deepseek.com. Models: deepseek-v4-pro[1m], deepseek-v4-pro, deepseek-v4-flash.",
      "secret": "op://YOUR_VAULT/YOUR_ITEM/YOUR_FIELD",
      "default_model": "deepseek-v4-pro[1m]",
      "router": {
        "capable": false
      },
      "native": {
        "default_model": "deepseek-v4-pro[1m]",
        "claude": {
          "requires_model": true,
          "requires_key": true,
          "clear_env": [
            "ANTHROPIC_CUSTOM_HEADERS"
          ],
          "env": {
            "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
            "ANTHROPIC_AUTH_TOKEN": "{api_key}",
            "ANTHROPIC_API_KEY": "",
            "ANTHROPIC_MODEL": "{model}",
            "ANTHROPIC_DEFAULT_OPUS_MODEL": "{model}",
            "ANTHROPIC_DEFAULT_SONNET_MODEL": "{model}",
            "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-flash",
            "CLAUDE_CODE_SUBAGENT_MODEL": "deepseek-v4-flash",
            "CLAUDE_CODE_EFFORT_LEVEL": "max"
          }
        }
      }
    },
    "opencode-go": {
      "_note": "OpenCode Zen 'go' endpoint (OpenAI-compatible). Router only. Uses OPENCODE_GO_API_KEY; seed via `fry keys import-env opencode-go` (after setting $OPENCODE_GO_API_KEY) or `fry keys set opencode-go`. Non-free 'go' models may require an OpenCode subscription.",
      "secret": null,
      "default_model": "glm-5.1",
      "router": {
        "capable": true,
        "kind": "openai_compat",
        "expand": false,
        "api_base_url": "https://opencode.ai/zen/go/v1/chat/completions",
        "env_var": "OPENCODE_GO_API_KEY",
        "secret": null,
        "transformer": null,
        "models": [
          "glm-5.1",
          "glm-5",
          "kimi-k2.5",
          "kimi-k2.6",
          "kimi-k3",
          "deepseek-v4-pro",
          "deepseek-v4-flash",
          "mimo-v2-pro",
          "mimo-v2.5-pro",
          "mimo-v2.5",
          "qwen3.6-plus",
          "qwen3.5-plus"
        ],
        "models_fallback": []
      }
    },
    "opencode-zen": {
      "_note": "OpenCode Zen endpoint (OpenAI-compatible). Router only. Uses OPENCODE_ZEN_API_KEY; seed via `fry keys import-env opencode-zen`. '*-free' models work on the free tier. NOTE: minimax-m2.7/m2.5 (non-free) are Anthropic-upstream (not OpenAI-chat) so excluded here.",
      "secret": null,
      "default_model": "deepseek-v4-flash-free",
      "router": {
        "capable": true,
        "kind": "openai_compat",
        "expand": false,
        "api_base_url": "https://opencode.ai/zen/v1/chat/completions",
        "env_var": "OPENCODE_ZEN_API_KEY",
        "secret": null,
        "transformer": null,
        "models": [
          "deepseek-v4-flash-free",
          "mimo-v2.5-free",
          "hy3-free",
          "nemotron-3-ultra-free",
          "north-mini-code-free",
          "big-pickle",
          "glm-5.1",
          "glm-5",
          "kimi-k2.5",
          "kimi-k2.6",
          "qwen3.6-plus",
          "qwen3.5-plus"
        ],
        "models_fallback": []
      }
    }
  }
}